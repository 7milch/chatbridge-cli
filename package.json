{
  "name": "chatbridge-monorepo",
  "private": true,
  "workspaces": ["packages/*", "examples/*"],
  "scripts": {
    "lint": "biome check .",
    "build": "tsc --build && bun run --filter @chatbridge/vscode build:webview",
    "test": "bun run build && bun test",
    "check": "bun run lint && bun run test",
    "e2e:vscode": "bun run build && bun run --filter chatbridge-example-vscode-dummy-chat e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.4.1",
    "@types/node": "^26.5.0",
    "typescript": "^5.6.0"
  }
}
